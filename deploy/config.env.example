VDA_DATABASE_URL=postgres://vda:REPLACE_ME@metadata:5432/vda
# Generate independently; keep stable and backed up. Required, no default.
VDA_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
VDA_BIND=0.0.0.0:8080
VDA_METADATA_POOL_SIZE=20
VDA_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
VDA_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
VDA_COOKIE_SECURE=true
VDA_ALLOWED_CIDRS=10.0.0.0/8,192.168.0.0/16
VDA_TRUST_PROXY_HEADERS=true
# Only actual reverse-proxy source networks, never arbitrary client networks.
VDA_TRUSTED_PROXY_CIDRS=10.42.0.0/16
VDA_ALLOW_PRIVATE_TARGETS=false
VDA_LOG_FORMAT=json
RUST_LOG=info

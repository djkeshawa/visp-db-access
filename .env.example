# Metadata store (Postgres). Stores users, clusters, policies, audit logs.
VDA_DATABASE_URL=postgres://vda:vda@localhost:5432/vda
# 32-byte key, base64. Encrypts target database credentials at rest (AES-256-GCM).
# Generate: openssl rand -base64 32
VDA_MASTER_KEY=
VDA_BIND=0.0.0.0:8080
VDA_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
VDA_BOOTSTRAP_ADMIN_PASSWORD=change-me-please
VDA_COOKIE_SECURE=false
# Comma-separated CIDRs allowed to reach the console. Empty = allow all.
VDA_ALLOWED_CIDRS=
VDA_TRUST_PROXY_HEADERS=false
RUST_LOG=info,vda_server=debug
